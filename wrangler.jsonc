{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "our-little-world",
  "main": "cloudflare/entry.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "our-little-world",
      "database_id": "3d6568c2-5753-4644-bf68-04724e43e8ca",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "APP_URL": "https://our-little-world.supawat-you.workers.dev"
  },
  "observability": {
    "enabled": false
  },
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": { "binding": "APP_VERSION" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_BACKEND",
        "class_name": "AccountBackend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-account-backend",
      "new_sqlite_classes": ["AccountBackend"]
    }
  ]
}
